# TripWise Frontend Environment Configuration Example
# IMPORTANT: Only public and client-safe keys are allowed in this file.
# Secret API keys (database passwords, private tokens) must NEVER be placed in the frontend.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Client Credentials (safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Razorpay Test Mode Key (Public identifier, safe for browser checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
